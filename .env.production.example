# ============================================================
# Infrastructure Operations Platform
# Production Environment Example
# ============================================================

# Application
APP_NAME=Infrastructure Operations Portal
APP_VERSION=0.1.0
APP_ENV=production
APP_PORT=8088

# Container Image
# Replace with the Docker Hub repository used for deployment.
DOCKER_IMAGE=syawalans/infrastructure-operations-platform
IMAGE_TAG=0.1.0

# PostgreSQL
POSTGRES_DB=infrastructure_ops
POSTGRES_USER=infrastructure_user
POSTGRES_PASSWORD=replace_with_a_strong_production_password

# Monitoring Worker
MONITORING_SCHEDULER_POLL_SECONDS=5

# Authentication
AUTH_SESSION_LIFETIME_HOURS=8

# Cookie Security
# Production deployments behind HTTPS should keep these enabled.
AUTH_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# Login Throttling
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_BLOCK_SECONDS=600
