# Application
APP_NAME=Infrastructure Operations Portal
APP_VERSION=0.1.0
APP_ENV=development
APP_PORT=8088

# PostgreSQL
POSTGRES_DB=infrastructure_ops
POSTGRES_USER=infrastructure_user
POSTGRES_PASSWORD=replace_with_strong_password

# Local development database connection
# Docker Compose overrides DATABASE_URL internally and uses the postgres service hostname.
DATABASE_URL=postgresql+psycopg://infrastructure_user:replace_with_strong_password@127.0.0.1:5432/infrastructure_ops

# Monitoring Worker
MONITORING_SCHEDULER_POLL_SECONDS=5

# Authentication
AUTH_SESSION_LIFETIME_HOURS=8

# Cookie Security
# Keep false for local HTTP development.
# Set both to true when the application is served over HTTPS.
AUTH_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Login Throttling
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOGIN_BLOCK_SECONDS=600
